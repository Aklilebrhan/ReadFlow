# ==============================================================================
# READFLOW ENVIRONMENT CONFIGURATION
# ==============================================================================

# Application Environment
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO
APP_NAME=ReadFlow
APP_VERSION=1.0.0
API_V1_PREFIX=/api/v1

# Server Settings
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Database Configuration (PostgreSQL + pgvector)
# For production/Docker Compose:
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/readflow
# For local lightweight dev/testing fallback:
# DATABASE_URL=sqlite+aiosqlite:///./data/readflow.db

# Storage Provider: "local" or "s3"
STORAGE_PROVIDER=local
LOCAL_STORAGE_PATH=./data/storage
# S3 / MinIO Settings (optional if STORAGE_PROVIDER=s3)
S3_ENDPOINT_URL=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET_NAME=readflow-documents
S3_REGION=us-east-1

# AI Provider Settings
# Options: "mock" (default, zero-cost, deterministic), "openai", "gemini", "ollama"
AI_PROVIDER=mock

# OpenAI Configuration
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_API_BASE=https://api.openai.com/v1

# Google Gemini Configuration
GEMINI_API_KEY=
GEMINI_CHAT_MODEL=gemini-1.5-flash
GEMINI_EMBEDDING_MODEL=text-embedding-004

# Ollama Configuration
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=llama3.2
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# Document Chunking Defaults
CHUNK_SIZE=800
CHUNK_OVERLAP=150
CHUNK_STRATEGY=recursive

# Retrieval Defaults
RETRIEVAL_TOP_K=5
RETRIEVAL_SIMILARITY_THRESHOLD=0.3
ENABLE_HYBRID_SEARCH=true
HYBRID_ALPHA=0.6

# OCR Configuration
OCR_ENABLED=true
OCR_ENGINE=tesseract

# Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_APP_NAME=ReadFlow
