{
  "name": "readflow-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "ReadFlow — AI-Powered Document Intelligence Platform",
  "workspaces": [
    "apps/web",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "npm --workspace=apps/web run dev",
    "build:web": "npm --workspace=apps/web run build",
    "lint:web": "npm --workspace=apps/web run lint",
    "test:web": "npm --workspace=apps/web run test"
  },
  "keywords": [
    "document-intelligence",
    "rag",
    "pdf-ai",
    "research-assistant"
  ],
  "author": "ReadFlow Team",
  "license": "MIT"
}
